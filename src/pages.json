{
  "easycom": {
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index"
    }
  ],
  "subPackages": [
    {
      "root": "pageIndex",
      "pages": [
        {
          "path": "submit"
        },
        
        {
          "path": "selectHarbour"
        }
      ]
    },
    {
      "root": "pageMy",
      "pages": [
        {
          "path": "information"
        },
        {
          "path": "user"
        },
        {
          "path": "detail"
        },
        {
          "path": "harbour"
        },{
          "path": "add"
        },
        {
          "path": "my",
          "style": {
            "navigationStyle": "custom"
          }
        }
      ]
    },
    {
      "root": "pageLogin",
      "pages": [
        {
          "path": "login"
        },
        {
          "path": "register"
        }
      ]
    },
    {
      "root": "pageShip",
      "pages": [
        {
          "path": "declare"
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "uni-app",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8",
    "navigationStyle": "custom"
  },
